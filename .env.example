# Copy to .env and fill in. Never commit .env itself.

# --- Notion ------------------------------------------------------------
# Integration token — needs access to the four databases below (share each
# one with the integration in Notion: "..." menu -> Connections -> Add).
NOTION_TOKEN=

# Capture Log: the attendance data source. This is the newer data-source API
# id (Notion's multi-source model), not the plain database id — open the
# database as a full page, "..." -> Copy link, and take the id after the
# last / (before any ?v=).
NOTION_DB_DS_ID=
NOTION_DS_VERSION=2025-09-03
NOTION_VERSION=2022-06-28

# Tracked Groups: one row per Telegram group the bot captures (Label / ID /
# Enabled). Same database the bot itself writes to.
NOTION_TRACKED_DB_ID=

# Telegram Accounts: one row per Telegram account seen posting (Name /
# Username), used to show a worker's display name.
NOTION_ACCOUNTS_DB_ID=

# Week Approvals: one row per (Group, Week Start) the dashboard has ever
# touched. Created automatically the first time a week is approved if the
# database id below points at an empty database with the right schema
# (Label [title], Group [relation to Tracked Groups], Week Start [date],
# Approved [checkbox]) — create the database and schema yourself first.
NOTION_APPROVALS_DB_ID=

# --- Dashboard behavior --------------------------------------------------
# Shared secret (sent as the X-Approve-Token header) required for
# everything that touches real attendance data: viewing, approving, and
# editing a day cell. Leave unset and the dashboard has NO data access at
# all — it fails closed, not open.
DASHBOARD_APPROVE_TOKEN=

# How often the background loop re-derives NOT-approved weeks from the
# Capture Log (seconds). Each cycle re-pulls the whole Capture Log, so this
# is deliberately gentle rather than near-instant.
DASHBOARD_REFRESH_SECONDS=60

# Local timezone — week boundaries (Mon-Sun) are computed in local time.
TZ=Europe/Kyiv
